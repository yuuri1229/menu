rules_version = '2';

// こんだて帖のデータは、members に登録されたアカウントだけが読める。
// アプリから書き換えられるのは「作った」「買った」、在庫（登録と、名前・数量・期限などの編集）、買い物リストへの追加と削除、
// 献立の感想、外食・不在の予定、レシートの登録済みの印、通知を受け取る自分の端末の登録だけ。
// それ以外（献立づくり・レシートの記録など）は Claude が scripts/db.mjs で書く
// （サービスアカウントはこのルールの対象外）。
// 変更したら scripts/schema.mjs の MEMBER_WRITABLE も合わせ、`node scripts/db.mjs rules:deploy` で反映する。
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function onlyChanges(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field]);
    }

    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 通知を受け取る端末。メンバーが自分の端末だけを登録・削除できる（送るのは scripts/db.mjs）
    match /pushSubscriptions/{id} {
      function validSub() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'endpoint', 'keys', 'device', 'createdAt'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('https://.*');
      }
      allow create: if isMember() && validSub();
      allow update: if isMember() && resource.data.uid == request.auth.uid && validSub();
      allow read, delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // 通知の秘密鍵など。サービスアカウント（scripts/db.mjs）だけが読む
    match /secrets/{id} {
      allow read, write: if false;
    }

    match /meta/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /notes/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /purchases/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /meals/{id} {
      allow read: if isMember();
      allow update: if isMember() && onlyChanges('done') && request.resource.data.done is bool;
    }

    // 献立の感想。id は献立の id（1献立1件、送り直すと上書き）。項目と選択肢は scripts/schema.mjs と同じ。
    // reflectedAt（好みの記録にまとめた時刻）は Claude が付け、アプリは送り直すときに空へ戻すだけ
    match /feedback/{mealId} {
      function validFeedback() {
        let d = request.resource.data;
        return d.keys().hasOnly(['mealId', 'mealTitle', 'date', 'slot', 'verdict', 'tags', 'text', 'uid', 'updatedAt', 'reflectedAt'])
          && d.mealId == mealId
          && exists(/databases/$(database)/documents/meals/$(mealId))
          && d.uid == request.auth.uid
          && d.verdict in ['好み', 'ふつう', '合わない']
          && d.tags is list && d.tags.size() <= 7
          && d.tags.hasOnly(['味が濃い', '味が薄い', '量が多い', '量が少ない', '手間だった', 'また食べたい', '苦手な食材'])
          && d.text is string && d.text.size() <= 500
          && d.mealTitle is string
          && (d.date == null || d.date is string)
          && (d.slot == null || d.slot in ['朝食', '昼食', '夕食'])
          && d.updatedAt is string
          && d.reflectedAt == null;
      }
      allow read: if isMember();
      allow create, update: if isMember() && validFeedback();
    }

    // 外食・不在の予定。項目と選択肢は scripts/schema.mjs と同じ。handledAt（献立に反映した時刻）は Claude が付け、
    // アプリは書き直すときに空へ戻すだけ。反映前の予定は消せる。反映後に予定がなくなったら canceled を true にして
    // Claude に献立を戻してもらう（戻したら Claude が消す）
    match /plans/{id} {
      function validPlan() {
        let d = request.resource.data;
        return d.keys().hasOnly(['date', 'slots', 'endDate', 'endSlots', 'kind', 'memo', 'canceled', 'uid', 'updatedAt', 'handledAt'])
          && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.slots is list && d.slots.size() >= 1 && d.slots.size() <= 3
          && d.slots.hasOnly(['朝食', '昼食', '夕食'])
          // 数日家を空けるときは帰宅日（出発日より後）と、帰宅日に食べない食事
          && (!('endDate' in d) || d.endDate == null
            || (d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.endDate > d.date
              && d.endSlots is list && d.endSlots.size() >= 1 && d.endSlots.size() <= 3
              && d.endSlots.hasOnly(['朝食', '昼食', '夕食'])))
          && (!('endSlots' in d) || d.endSlots is list)
          && d.kind in ['外食', '不在']
          && d.memo is string && d.memo.size() <= 200
          && d.canceled is bool
          && d.uid == request.auth.uid
          && d.updatedAt is string
          && d.handledAt == null;
      }
      allow read: if isMember();
      allow create: if isMember() && validPlan() && request.resource.data.canceled == false;
      allow update: if isMember() && validPlan();
      allow delete: if isMember() && resource.data.handledAt == null && resource.data.canceled == false;
    }

    // レシートの登録待ち。Claude が写真から作る。アプリは重さと期限を在庫に登録したあと registeredAt を付けるだけ
    match /receipts/{id} {
      allow read: if isMember();
      allow update: if isMember() && onlyChanges('registeredAt') && request.resource.data.registeredAt is string;
    }

    function optStr(d, k) {
      return !(k in d) || d[k] == null || d[k] is string;
    }
    function optDate(d, k) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // 買い物リストの食材。アプリからは「買った」の切り替え、項目の追加、献立や明細が指していない項目の削除ができる
    // （参照の確認はアプリ側。Claude の CLI も参照切れを止める）
    match /ingredients/{id} {
      function validIngredient() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'category', 'storage', 'trip', 'tripDate', 'amount', 'estimate', 'bought', 'memo'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.amount is string && d.memo is string && d.bought is bool
          && optStr(d, 'category') && optStr(d, 'storage') && optStr(d, 'trip') && optDate(d, 'tripDate')
          && (!('estimate' in d) || d.estimate == null || d.estimate is number);
      }
      allow read: if isMember();
      allow create: if isMember() && validIngredient();
      allow update: if isMember() && onlyChanges('bought') && request.resource.data.bought is bool;
      allow delete: if isMember();
    }

    // 家の在庫。アプリから新しく登録・削除し、名前・数量・期限・状態などを直せる（魚介の確認は Claude が付ける）
    match /inventory/{id} {
      function validInventory() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'category', 'storage', 'status', 'remaining', 'memo', 'seafood', 'bestBefore', 'purchasedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.remaining is string && d.remaining.size() <= 60
          && d.memo is string && d.memo.size() <= 300
          && optStr(d, 'category') && optStr(d, 'storage')
          && (!('status' in d) || d.status == null || d.status in ['十分', '残りわずか', '切れた', '要確認'])
          && (!('seafood' in d) || d.seafood == null || d.seafood in ['問題なし', '要確認', 'NG'])
          && optDate(d, 'bestBefore') && optDate(d, 'purchasedAt');
      }
      allow read: if isMember();
      allow create: if isMember() && validInventory();
      allow update: if isMember() && validInventory()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'category', 'storage', 'status', 'remaining', 'memo', 'bestBefore', 'purchasedAt']);
      allow delete: if isMember();
    }
  }
}
